# ---- SMTP (server-only — never prefix these with NEXT_PUBLIC_) ----
# Powers the /contact "Send a Quick Enquiry" form via app/api/contact/route.ts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password

# Envelope sender. Must be a mailbox the SMTP account may send as.
# Defaults to SMTP_USER when unset.
MAIL_FROM=you@yourdomain.com
MAIL_FROM_NAME=Aditya Kumar Upadhyay

# Where /contact enquiries are delivered.
# Falls back to NEXT_PUBLIC_CONTACT_EMAIL, then SMTP_USER.
CONTACT_TO_EMAIL=aditya@yourdomain.com

# Where lead-magnet notifications land (email capture → PDF delivery via
# app/api/lead-magnet). Optional — falls back to CONTACT_TO_EMAIL,
# then NEXT_PUBLIC_CONTACT_EMAIL, then SMTP_USER.
LEADS_TO_EMAIL=aditya@yourdomain.com

# Where completed Transformation Audits land, PDF attached (app/api/audit).
# Optional — falls back to CONTACT_TO_EMAIL, then NEXT_PUBLIC_CONTACT_EMAIL,
# then SMTP_USER.
AUDIT_TO_EMAIL=aditya@yourdomain.com

# ---- Public config (exposed to the browser) ----
NEXT_PUBLIC_CONTACT_EMAIL=aditya@yourdomain.com
# Digits only — no +, spaces or dashes. e.g. 918420707031
NEXT_PUBLIC_WHATSAPP_NUMBER=918420707031
NEXT_PUBLIC_COACH_WHATSAPP=918420707031

# Social. Both have real fallbacks in lib/config.ts — set these only to override.
NEXT_PUBLIC_IG_URL=https://www.instagram.com/adityakumarupadhyay_
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@Adityakumarupadhyaymindset
