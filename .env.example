# ---- SMTP (server-only — never prefix these with NEXT_PUBLIC_) ----
# Powers the /contact "Send a Quick Enquiry" form via app/api/contact/route.ts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password

# Envelope sender. Must be a mailbox the SMTP account may send as.
# Defaults to SMTP_USER when unset.
MAIL_FROM=you@yourdomain.com
MAIL_FROM_NAME=Aditya Kumar Upadhyay

# Where enquiries are delivered.
# Falls back to NEXT_PUBLIC_CONTACT_EMAIL, then SMTP_USER.
CONTACT_TO_EMAIL=aditya@yourdomain.com

# ---- Public config (exposed to the browser) ----
NEXT_PUBLIC_CONTACT_EMAIL=aditya@yourdomain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_COACH_WHATSAPP=91XXXXXXXXXX
